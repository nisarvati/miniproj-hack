# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL (MedLink metadata DB) ---
POSTGRES_USER=medlink
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medlink
POSTGRES_PORT=5433
DATABASE_URL=postgres://medlink:change-me@localhost:5433/medlink

# --- Redis ---
REDIS_URL=redis://localhost:6379
# Standalone (the default) uses REDIS_URL. For the docker Redis Cluster (`npm run cluster:up`) set:
# REDIS_MODE=cluster
REDIS_CLUSTER_NODES=localhost:7001,localhost:7002,localhost:7003   # seed nodes; the rest is discovered
# REDIS_CLUSTER_NAT=local           # docker cluster only: map the announced node names (redis-node-1:7001) to 127.0.0.1
# --- Used in later milestones ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000   # public address of the web app; makes the homepage canonical link absolute

# --- search-service ---
PORT=4000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Units at or below which a medicine counts as low on stock: the public "low stock" label (search service) and the staff low-stock alerts and risk score (pharmacy portal).
LOW_STOCK_THRESHOLD=5
# Live stock in search: the API overlays the Redis state kept by the sync service on the catalogue database, using the
# Redis settings above. Set LIVE_STOCK=off to answer from the catalogue database alone.
# LIVE_STOCK=off

# Ranking weights (relative; normalised to sum to 1) and distance scale
RANK_WEIGHT_AVAILABILITY=0.4
RANK_WEIGHT_DISTANCE=0.3
RANK_WEIGHT_PRICE=0.2
RANK_WEIGHT_RELEVANCE=0.1
RANK_MAX_DISTANCE_KM=15

# --- pharmacy-portal (staff sign-in and stock editing: `npm run portal:seed-users`, then `npm run portal:dev`) ---
# Changes go to the pharmacy's own database (PHARMACY_P00x_DATABASE_URL below), so the connector and sync service must
# be running (`npm run connector:start`, `npm run sync:start`) for them to reach shoppers.
NEXT_PUBLIC_PORTAL_URL=http://localhost:4200
PORTAL_PORT=4200
# PORTAL_SESSION_SECRET=            # signs the session cookie; at least 16 characters. Required in production.
# PORTAL_SESSION_HOURS=8
# PORTAL_DEV_PASSWORD=medlink-dev   # password given to the seeded accounts p001@pharmacy.test ... p005@pharmacy.test. DEVELOPMENT ONLY: change it (or do not
#                                   # run portal:seed-users) on any machine other people can reach.
# HOST=127.0.0.1                    # the portal and search API listen on this machine only by default. Listening on anything else REQUIRES PORTAL_SESSION_SECRET.
# PORTAL_ADMIN_PASSWORD=            # used only by `npm run portal:users -- create-admin <email>` (at least 12 characters); put it on the command line, not here.

# --- Independent pharmacy databases (one DB + one role per pharmacy; created by `npm run pharmacies:setup`) ---
PHARMACY_P001_DATABASE_URL=postgres://pharmacy_p001:change-me@localhost:5433/pharmacy_p001
PHARMACY_P002_DATABASE_URL=postgres://pharmacy_p002:change-me@localhost:5433/pharmacy_p002
PHARMACY_P003_DATABASE_URL=postgres://pharmacy_p003:change-me@localhost:5433/pharmacy_p003
PHARMACY_P004_DATABASE_URL=postgres://pharmacy_p004:change-me@localhost:5433/pharmacy_p004
PHARMACY_P005_DATABASE_URL=postgres://pharmacy_p005:change-me@localhost:5433/pharmacy_p005
# Optional demo directory listing P006 (docs/demo-pharmacies.md). Each needs its own database and role, which are
# NOT created by anything automatically. A pharmacy joins only when its URL is set; leave these unset to keep the five above.
# PHARMACY_P006_DATABASE_URL=postgres://pharmacy_p006:change-me@localhost:5433/pharmacy_p006

# --- inventory-connector ---
# CONNECTOR_PHARMACIES=P001,P002   # optional: run only these pharmacies (default: all)
CONNECTOR_POLL_INTERVAL_MS=1000
CONNECTOR_BATCH_SIZE=50

# --- inventory-sync (Redis Streams consumer) ---
# REDIS_KEY_PREFIX=medlink          # namespace for all Redis keys (tests use a random one)
# SYNC_GROUP=inventory-sync         # consumer group; run several instances in the same group to share work
# SYNC_BATCH_SIZE=50
# SYNC_BLOCK_MS=2000
# SYNC_MIN_IDLE_MS=10000            # unacknowledged entries are retried / taken over after this long
# SYNC_MAX_DELIVERIES=5             # after this many failed attempts an event goes to the dead-letter stream
# SYNC_DEDUP_RETENTION_HOURS=168    # how long a handled eventId is remembered (duplicates inside this window are ignored)
# SYNC_DEDUP_LEASE_MS=30000         # a delivery holds an event this long before another may take over
# SYNC_MIRROR=off                   # by default, with DATABASE_URL set, applied changes are also copied into the central
#                                   # `inventory` table (search's fallback when live stock is unavailable)
# REDIS_PORT=6379                   # host port for the Redis container

# --- notification-service (restock notifications; reads the same event streams as inventory-sync) ---
# Needs DATABASE_URL (above) for subscriptions and notifications, and the Redis settings above.
# NOTIFY_SWEEP_INTERVAL_MS=5000     # stored-but-unsent notifications are sent this often (covers a crash after storing)
# NOTIFY_MIN_IDLE_MS=10000          # unacknowledged events are retried / taken over after this long
# NOTIFY_MAX_DELIVERIES=5           # after this many failed attempts an event goes to the dead-letter stream

# --- pharmacy simulator (npm run demo / npm run simulator) ---
# Uses PHARMACY_P00x_DATABASE_URL and the Redis settings above; DATABASE_URL is optional (needed for the notification part).
# SIM_TRACE_TIMEOUT_MS=15000        # how long a change is followed through the pipeline before giving up

# --- notification-service: restock emails (off by default) ---
# Real email is sent only when EMAIL_DELIVERY_ENABLED=true AND the Gmail account and its App Password are set. Put the real
# values in your own .env (git-ignored), never in this file, and never paste the App Password into chat or code.
# EMAIL_DELIVERY_ENABLED=false
# SMTP_USER=your-sender@gmail.com
# SMTP_PASS=
# EMAIL_FROM=MedLink <your-sender@gmail.com>   # optional; Gmail only sends as the authenticated account
# (the link in the email uses NEXT_PUBLIC_SITE_URL, above)

# --- other optional settings the code reads ---
# SYNC_CONSUMER=                    # name of this inventory-sync instance inside its consumer group (default: host and process id)
# NOTIFY_CONSUMER=                  # same, for the notification service
# NEXT_DIST_DIR=.next               # where the web app writes its build output, if you need a second copy running at once
# PORTAL_URL=http://localhost:4200  # npm run perf:measure: where the portal and search API are
# API_URL=http://localhost:4000
# --- health endpoints of the background services (read by `npm run services:status`) ---
# Each of the connector, sync service and notification service answers GET /health on 127.0.0.1. Defaults shown; set "off" to disable one.
# HEALTH_PORT_CONNECTOR=4301
# HEALTH_PORT_SYNC=4302
# HEALTH_PORT_NOTIFY=4303

# --- Google sign-in for patients (web app; see docs/authentication.md) ---
# These are read by the Next.js web app, which loads apps/web/.env.local, NOT this root .env. Put the real values there (it is
# git-ignored). Optional: the site works without them, "Sign in" is simply hidden.
# AUTH_SECRET=            # signs and encrypts the session cookie: `openssl rand -base64 32`
# AUTH_GOOGLE_ID=         # OAuth client ID from Google Cloud Console
# AUTH_GOOGLE_SECRET=     # OAuth client secret. Never commit it, never expose it to the browser.
# DATABASE_URL=                  # ALSO needed here for the patient calendar (docs/medicine-calendar.md): the web app talks to the central PostgreSQL for it. Same value as the root DATABASE_URL.
# AUTH_URL=http://localhost:3000   # only needed behind a proxy / in production (with AUTH_TRUST_HOST=true if the host header is trusted)

# --- Deployment (Vercel + Render): all optional, and unset for local development. See docs/deployment.md. ---
# Web app (Vercel). SERVER-SIDE, read when the app is BUILT (a change needs a new build). Never NEXT_PUBLIC_*.
# PORTAL_UPSTREAM_URL=https://your-portal.onrender.com   # where /portal-api/portal/* is forwarded: an https origin only. Leave NEXT_PUBLIC_PORTAL_URL UNSET on Vercel so the browser uses /portal-api.
# Pharmacy portal (Render web service).
# PORTAL_PORT=10000                 # the portal reads PORTAL_PORT, not PORT: set it to the port Render expects (and HOST=0.0.0.0, PORTAL_SESSION_SECRET, NODE_ENV=production)
# TRUST_PROXY=2                     # reverse proxies in front of the portal (Vercel, then Render), so the login throttle counts real visitors. Verify the number against a real request.
# Worker health across machines. Workers write a heartbeat to Redis; the search service reads it.
# WORKER_HEARTBEAT=redis            # on each of the connector, sync service and notification service
# WORKER_HEARTBEAT_INTERVAL_MS=10000
# WORKER_INSTANCE=                  # a stable name for this worker instance (default: host and process id)
# WORKER_HEALTH=redis               # on the search service: http (default, local /health endpoints), redis, or off
# WORKER_HEALTH_STALE_AFTER_MS=35000   # a heartbeat older than this is "stale"
# WORKER_HEALTH_URL_CONNECTOR=      # http mode only: the connector's health URL on a private network (it must listen there: HEALTH_HOST)
# WORKER_HEALTH_URL_SYNC=
# HEALTH_HOST=127.0.0.1             # where a worker's own /health endpoint listens (set HEALTH_PORT_*=off on Render, where nothing needs it)

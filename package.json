{
  "name": "medlink",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "npm run migrate -w @medlink/db",
    "db:seed": "npm run seed -w @medlink/db",
    "db:catalogue": "npm run catalogue:import -w @medlink/db --",
    "db:reset": "npm run reset -w @medlink/db",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w @medlink/web",
    "lint": "eslint .",
    "test": "vitest run",
    "portal:dev": "npm run dev -w @medlink/pharmacy-portal",
    "portal:seed-users": "npm run seed-users -w @medlink/pharmacy-portal",
    "portal:users": "npm run users -w @medlink/pharmacy-portal --",
    "web:dev": "npm run dev -w @medlink/web",
    "api:dev": "npm run dev -w @medlink/search-service",
    "pharmacies:setup": "npm run pharmacies:setup -w @medlink/db",
    "pharmacies:migrate": "npm run pharmacies:migrate -w @medlink/db",
    "pharmacies:status": "npm run pharmacies:status -w @medlink/db",
    "pharmacies:reset": "npm run pharmacies:reset -w @medlink/db",
    "connector:start": "npm run start -w @medlink/inventory-connector",
    "infra:up": "docker compose up -d --wait postgres redis",
    "cluster:up": "docker compose --profile cluster up -d --wait redis-cluster-init",
    "cluster:down": "docker compose --profile cluster rm -sf redis-cluster-init redis-node-1 redis-node-2 redis-node-3 redis-node-4 redis-node-5 redis-node-6",
    "test:cluster": "REDIS_MODE=cluster REDIS_CLUSTER_NODES=localhost:7001,localhost:7002,localhost:7003 REDIS_CLUSTER_NAT=local vitest run",
    "sync:start": "npm run start -w @medlink/inventory-sync",
    "notify:start": "npm run start -w @medlink/notification-service",
    "dev:all": "tsx --env-file-if-exists=.env scripts/dev-all.ts",
    "services:status": "tsx --env-file-if-exists=.env scripts/services-status.ts",
    "perf:measure": "tsx --env-file-if-exists=.env scripts/measure-latency.ts",
    "notify:test-email": "npm run send-test-email -w @medlink/notification-service --",
    "demo:seed": "npm run demo:seed -w @medlink/pharmacy-simulator --",
    "demo:directory-setup": "npm run demo:directory-setup -w @medlink/pharmacy-simulator --",
    "demo:register": "npm run demo:register -w @medlink/pharmacy-simulator --",
    "simulator": "npm run start -w @medlink/pharmacy-simulator --",
    "demo": "npm run start -w @medlink/pharmacy-simulator -- --embedded demo"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
